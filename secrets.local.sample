# Private environment variables (not tracked in git).
#
# Copy this file to secrets.local and fill in your values:
#   cp ~/.dotfiles/secrets.local.sample ~/.dotfiles/secrets.local
#
# Loaded by ~/.zshenv on every zsh invocation (interactive shells, scripts,
# and tools like Claude Code). Use this for API keys and tokens that need to
# be available outside an interactive login shell.
#
# For aliases, proxy settings, and interactive-only config, use profile.local
# instead (sourced from ~/.zshrc).

# ---------------------------------------------------------------------------
# Plain export (simplest; secrets live as plaintext on disk)
# ---------------------------------------------------------------------------

# export LINEAR_API_KEY="your-linear-api-key"
# export UPTIME_ROBOT_KEY="your-uptime-robot-key"
# export UNSPLASH_ACCESS_KEY="your-unsplash-access-key"
# export GH_TOKEN="your-github-personal-access-token"

# ---------------------------------------------------------------------------
# macOS Keychain (more secure; secret never stored in a dotfile)
#
# Store once:
#   security add-generic-password -a "$USER" -s "linear-api" -w "your-key"
#
# Load at shell startup. Assign first, then export only if non-empty, so a
# missing entry doesn't clobber the variable with "":
#   _v="$(security find-generic-password -a "$USER" -s "linear-api" -w 2>/dev/null)"
#   [ -n "$_v" ] && export LINEAR_API_KEY="$_v"; unset _v
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 1Password CLI (more secure; secret managed in 1Password vault)
#
# Requires: brew install 1password-cli && op signin
#
# Note: this file is sourced on every zsh invocation, so `op read` here runs
# on every shell spawn and can add latency or trigger an unlock prompt when
# the vault is locked. Prefer the `op run` form below, or cache the value.
#
# Read a field directly (same non-empty guard as above):
#   _v="$(op read "op://Personal/Linear/credential" 2>/dev/null)"
#   [ -n "$_v" ] && export LINEAR_API_KEY="$_v"; unset _v
#
# Or inject env vars only when running a command (nothing written to disk):
#   op run --env-file=<(echo 'LINEAR_API_KEY=op://Personal/Linear/credential') -- your-command
# ---------------------------------------------------------------------------
