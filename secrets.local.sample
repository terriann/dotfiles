# Interactive-shell secrets (not tracked in git).
#
# Copy this file to secrets.local and fill in your values:
#   cp ~/.dotfiles/secrets.local.sample ~/.dotfiles/secrets.local
#   chmod 600 ~/.dotfiles/secrets.local
#
# Sourced late from `profile`, which is loaded from ~/.zshrc — so this runs
# only in INTERACTIVE shells, and only after PATH is fully set up. That makes
# it the place for secrets that need a real PATH or a TTY: 1Password (`op`),
# prompts, anything slow.
#
# It is NOT seen by `zsh -c ...`, scripts, cron, or tools like Claude Code.
# Static secrets those need go in ~/.zshenv instead (see zshenv.sample).
#
# Keeping these out of profile.local is just tidiness: profile.local is for
# machine-specific config (aliases, proxies, overrides); this file is for
# credentials. Both are gitignored via `*.local`.

# ---------------------------------------------------------------------------
# Plain export
# ---------------------------------------------------------------------------

# export LINEAR_API_KEY="your-linear-api-key"
# export GH_TOKEN="your-github-personal-access-token"

# ---------------------------------------------------------------------------
# macOS Keychain
#
# Store once (-T /usr/bin/security lets the CLI read it without a GUI prompt):
#   security add-generic-password -a "$USER" -s "linear-api" -w "your-key" -T /usr/bin/security
#
# Assign first, then export only if non-empty, so a missing entry can't
# clobber the variable with "":
#   _v="$(security find-generic-password -a "$USER" -s "linear-api" -w 2>/dev/null)"
#   [ -n "$_v" ] && export LINEAR_API_KEY="$_v"; unset _v
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 1Password CLI  (works here because PATH is ready and this is interactive)
#
# Requires: brew install 1password-cli && op signin
#
# Read a field directly. `op` may prompt to unlock the vault the first time
# per session:
#   _v="$(op read "op://Personal/Linear/credential" 2>/dev/null)"
#   [ -n "$_v" ] && export LINEAR_API_KEY="$_v"; unset _v
#
# Or don't export at all — inject vars only for the command that needs them,
# so nothing is written to disk or left in a long-lived environment:
#   op run --env-file=<(echo 'LINEAR_API_KEY=op://Personal/Linear/credential') -- your-command
#
# `op read` runs on every new interactive shell. If that gets slow, cache the
# resolved value to a chmod 600 file with a TTL and only refresh when stale.
# ---------------------------------------------------------------------------
